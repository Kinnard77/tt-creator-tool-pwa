# Copia este archivo como  .env.local  y rellena los dos valores.
# .env.local esta en .gitignore: nunca se sube a GitHub.
#
# Donde sacarlos:
#   supabase.com -> tu proyecto -> Settings -> API
#   URL      = "Project URL"
#   ANON KEY = "anon public"
#
# Despues de crear o cambiar este archivo hay que REINICIAR el servidor
# de desarrollo: Next.js solo lee las variables al arrancar.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
